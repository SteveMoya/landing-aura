---
import { site } from '../../data/site';
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="newsletter" ariaLabelledBy="newsletter-title">
  <div class="glass-strong relative overflow-hidden rounded-[2.5rem] px-6 py-16 text-center sm:px-16">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -left-20 -top-20 h-64 w-64 animate-pulse-glow rounded-full bg-rose/60 blur-[80px]"></div>
      <div class="absolute -bottom-24 -right-16 h-72 w-72 animate-pulse-glow rounded-full bg-lilac/60 blur-[90px] [animation-delay:2s]"></div>
      <div class="absolute left-1/3 top-10 h-32 w-32 rounded-full bg-mint/50 blur-[70px]"></div>
    </div>

    <div class="relative mx-auto max-w-xl">
      <span class="mx-auto mb-5 grid h-14 w-14 place-items-center rounded-full bg-gradient-to-br from-rose to-lilac shadow-glow-rose">
        <Icon name="sparkles" size={24} class="text-ink/80" />
      </span>
      <h2 id="newsletter-title" class="font-display text-4xl font-bold tracking-tight sm:text-5xl">
        {site.newsletter.title}
      </h2>
      <p class="mt-4 text-lg text-ink/65">{site.newsletter.subtitle}</p>

      <form data-newsletter-form class="mt-8 flex flex-col gap-3 sm:flex-row" novalidate>
        <label for="newsletter-email" class="sr-only">Correo electrónico</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          placeholder={site.newsletter.placeholder}
          class="glass-strong w-full rounded-full px-6 py-4 text-ink placeholder:text-ink/40 focus:outline-none focus:ring-2 focus:ring-lilac"
        />
        <button
          type="submit"
          class="shrink-0 rounded-full bg-ink px-8 py-4 font-body text-sm font-semibold text-aura-glow transition-transform duration-200 hover:-translate-y-0.5 active:scale-[0.97]"
        >
          {site.newsletter.button}
        </button>
      </form>
      <p
        data-newsletter-status
        class="mt-4 min-h-5 text-sm font-medium"
        data-success={site.newsletter.success}
        aria-live="polite"
      ></p>
      <p class="mt-2 text-xs text-ink/40">Prometemos: solo contenido hermoso. Puedes darte de baja cuando quieras.</p>
    </div>
  </div>
</Section>

<script>
  import { initNewsletter } from '../../scripts/newsletter';

  initNewsletter();
</script>