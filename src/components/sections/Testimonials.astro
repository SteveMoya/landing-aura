---
import { testimonials } from '../../data/testimonials';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="opiniones" ariaLabelledBy="testimonials-title">
  <div class="mb-14 max-w-2xl">
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-ink/45">Opiniones</p>
    <h2 id="testimonials-title" class="font-display text-4xl font-bold tracking-tight sm:text-5xl">
      Quienes ya <span class="bg-gradient-to-r from-pink-500 via-purple-500 to-teal-400 bg-clip-text text-transparent">viven su luz</span>
    </h2>
  </div>

  <ul class="grid gap-6 md:grid-cols-3">
    {
      testimonials.map((t, index) => (
        <li data-reveal style={`--reveal-delay:${index * 90}ms`}>
          <Card class="flex h-full flex-col">
            <div class="flex gap-1 text-ink/80" role="img" aria-label="Valoración: 5 de 5 estrellas">
              {Array.from({ length: 5 }).map(() => <Icon name="star" size={14} />)}
            </div>
            <blockquote class="mt-4 flex-1 font-display text-lg italic leading-relaxed text-ink/85">
              “{t.quote}”
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-ink/10 pt-4">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-gradient-to-br from-rose to-lilac font-display text-sm font-bold text-ink">
                {t.initials}
              </span>
              <div>
                <p class="font-semibold">{t.name}</p>
                <p class="text-xs text-ink/50">{t.role}</p>
              </div>
              <span class="ml-auto inline-flex items-center gap-1 text-xs font-medium text-ink/45">
                <Icon name="check" size={12} class="text-mint" />
                Verificada
              </span>
            </figcaption>
          </Card>
        </li>
      ))
    }
  </ul>
</Section>