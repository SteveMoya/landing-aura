---
import { benefits } from '../../data/benefits';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';

const tones: Record<string, string> = {
  rose: 'text-ink bg-rose/60',
  lilac: 'text-ink bg-lilac/60',
  peach: 'text-ink bg-peach/60',
  mint: 'text-ink bg-mint/60',
};
---

<Section id="beneficios" ariaLabelledBy="benefits-title">
  <div class="mb-14 grid items-center gap-8 lg:grid-cols-[1.1fr_minmax(0,0.9fr)] lg:gap-12">
    <div>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-ink/45">Beneficios</p>
      <h2 id="benefits-title" class="font-display text-4xl font-bold tracking-tight sm:text-5xl">
        Resultados que se <span class="bg-gradient-to-r from-pink-500 via-purple-500 to-teal-400 bg-clip-text text-transparent">notan en la luz</span>
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink/60">
        Un ritual diario que se percibe en la piel y en el estado de ánimo. Menos pasos, más constancia.
      </p>
    </div>

    <div data-reveal class="glass rounded-[2rem] p-3 shadow-aura transition-transform duration-300 hover:-translate-y-1">
      <div class="relative overflow-hidden rounded-[1.5rem]">
        <img
          src="/ritual-spa.jpg"
          alt="Ritual de cuidado personal Aura en un entorno de spa sereno"
          loading="lazy"
          class="h-full w-full object-cover"
        />
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-ink/35 via-transparent to-transparent"></div>
        <span class="absolute bottom-4 left-4 inline-flex items-center gap-2 rounded-full bg-white/70 px-4 py-1.5 font-display text-xs font-bold uppercase tracking-[0.15em] text-ink backdrop-blur-md">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-pink-500"></span>
          Rutina diaria
        </span>
      </div>
    </div>
  </div>

  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      benefits.map((b, index) => (
        <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <Card class="group h-full">
            <span class:list={['inline-flex h-12 w-12 items-center justify-center rounded-2xl transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6', tones[b.tone]]}>
              <Icon name={b.icon} size={22} />
            </span>
            <h3 class="mt-5 font-display text-xl font-bold tracking-tight">{b.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/60">{b.description}</p>
          </Card>
        </li>
      ))
    }
  </ul>
</Section>