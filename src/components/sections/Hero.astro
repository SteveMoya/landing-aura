---
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
---

<section class="relative overflow-hidden pt-28 md:pt-36">
  <!-- Luz difusa de fondo -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -left-32 -top-24 h-[520px] w-[520px] animate-pulse-glow rounded-full bg-rose/50 blur-[100px]"></div>
    <div class="absolute right-[-120px] top-1/4 h-[460px] w-[460px] animate-pulse-glow rounded-full bg-lilac/50 blur-[110px] [animation-delay:1.5s]"></div>
    <div class="absolute bottom-[-140px] left-1/3 h-[420px] w-[420px] animate-pulse-glow rounded-full bg-mint/40 blur-[100px] [animation-delay:3s]"></div>
    <div class="absolute right-1/4 top-0 h-40 w-40 rounded-full bg-peach/50 blur-[80px]"></div>
  </div>

  <div class="container-aura relative grid items-center gap-16 pb-24 lg:grid-cols-2 lg:pb-32">
    <div data-reveal>
      <Badge tone="lilac" class="mb-6">{site.hero.badge}</Badge>
      <h1 class="font-display text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
        {site.hero.title.start}
        <span class="bg-gradient-to-r from-pink-500 via-purple-500 to-teal-400 bg-clip-text text-transparent">
          {site.hero.title.accent}
        </span>
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-ink/65">{site.hero.subtitle}</p>
      <div class="mt-9 flex flex-col gap-4 sm:flex-row">
        <Button href="#productos" size="lg">
          {site.hero.primaryCta}
          <Icon name="sparkles" size={17} />
        </Button>
        <Button href="#beneficios" variant="glass" size="lg">
          {site.hero.secondaryCta}
        </Button>
      </div>
      <div class="mt-10 flex items-center gap-5">
        <div class="flex -space-x-3" aria-hidden="true">
          {['CD', 'LM', 'SH', 'AR'].map((ini) => (
            <span class="glass grid h-10 w-10 place-items-center rounded-full font-display text-xs font-bold text-ink ring-2 ring-aura-glow">
              {ini}
            </span>
          ))}
        </div>
        <p class="text-sm text-ink/55">
          <span class="font-semibold text-ink">+12.000</span> pieles iluminadas
        </p>
      </div>
    </div>

    <!-- Producto hero: frasco de vidrio con luz -->
    <div data-reveal style="--reveal-delay:120ms" class="relative mx-auto w-full max-w-md">
      <div class="glass-strong animate-float relative mx-auto flex h-[380px] w-[260px] items-center justify-center rounded-[2.5rem] sm:h-[440px] sm:w-[300px]">
        <!-- brillo interior -->
        <div aria-hidden="true" class="absolute inset-6 rounded-[2rem] bg-gradient-to-b from-rose/60 via-white/40 to-lilac/60"></div>
        <!-- frasco -->
        <div class="relative flex h-[70%] w-[52%] flex-col items-center justify-end rounded-b-[2.5rem] rounded-t-[1.25rem] border border-white/80 bg-gradient-to-b from-white/70 to-rose/40 shadow-aura backdrop-blur-sm">
          <span class="absolute top-10 h-10 w-[70%] rounded-full bg-white/70"></span>
          <span class="absolute top-[4.5rem] h-2 w-[80%] rounded-full bg-ink/15"></span>
          <span class="mb-8 font-display text-sm font-semibold tracking-[0.3em] text-ink/70">GLOW</span>
          <span class="h-14 w-14 rounded-full bg-gradient-to-br from-rose to-lilac shadow-glow-rose"></span>
          <span class="mt-5 mb-3 text-[10px] font-semibold uppercase tracking-[0.2em] text-ink/50">Serum · 30 ml</span>
        </div>
        <!-- gotas -->
        {[0, 1, 2, 3].map((i) => (
          <span
            aria-hidden="true"
            class="absolute h-3 w-3 rounded-full bg-white/80 shadow-[0_0_12px_rgb(255_255_255/0.9)]"
            style={`left:${16 + i * 22}%;top:${12 + (i % 2) * 20}%`}
          ></span>
        ))}
      </div>
    </div>
  </div>
</section>