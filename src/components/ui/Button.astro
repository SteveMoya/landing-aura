---
export type ButtonVariant = 'primary' | 'glass' | 'link';
export type ButtonSize = 'sm' | 'md' | 'lg';

interface Props {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  ariaLabel?: string;
  target?: string;
  rel?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  ariaLabel,
  target,
  rel,
  class: className,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-body text-sm font-semibold transition-all duration-200 ease-out focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-ink disabled:pointer-events-none disabled:opacity-40 active:scale-[0.97]';

const variants: Record<ButtonVariant, string> = {
  primary: 'bg-ink text-aura-glow hover:bg-ink/90 hover:-translate-y-0.5 shadow-[0_12px_32px_rgb(58_46_74/0.3)]',
  glass:
    'glass text-ink hover:bg-white/60 hover:-translate-y-0.5',
  link: 'px-0 text-ink underline-offset-4 hover:underline',
};

const sizes: Record<ButtonSize, string> = {
  sm: 'px-5 py-2.5 text-xs',
  md: 'px-7 py-3.5',
  lg: 'px-9 py-4 text-base',
};

const sizeClass = variant === 'link' ? '' : sizes[size];

const classes = [base, variants[variant], sizeClass, className].filter(Boolean).join(' ');
---

{
  href ? (
    <a
      href={href}
      class={classes}
      aria-label={ariaLabel}
      aria-disabled={disabled || undefined}
      target={target}
      rel={rel}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel} disabled={disabled}>
      <slot />
    </button>
  )
}