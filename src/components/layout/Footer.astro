---
import { site } from '../../data/site';
import Logo from '../brand/Logo.astro';
import Icon from '../ui/Icon.astro';
---

<footer class="border-t border-white/60 bg-white/40 backdrop-blur-xl">
  <div class="container-aura py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-5">
        <Logo />
        <p class="max-w-xs text-sm leading-relaxed text-ink/60">
          {site.description}
        </p>
        <div class="flex gap-3">
          {
            site.socials.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                class="glass inline-flex h-10 w-10 items-center justify-center rounded-full text-ink/70 transition-all duration-200 hover:-translate-y-0.5 hover:text-ink"
              >
                <Icon name={s.icon} size={17} />
              </a>
            ))
          }
        </div>
      </div>

      <nav aria-label="Explorar">
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-ink/50">Explorar</h3>
        <ul class="space-y-3">
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-ink/60 transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4">
        <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-ink/50">Contacto</h3>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 text-sm text-ink/60 transition-colors hover:text-ink"
        >
          <Icon name="mail" size={16} class="text-ink/40" />
          {site.email}
        </a>
        <p class="max-w-[220px] text-xs leading-relaxed text-ink/40">
          Atención real de dermatólogas y cosmetólogas, de lunes a sábado.
        </p>
      </div>

      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-ink/50">Regalo de bienvenida</h3>
        <a
          href="#newsletter"
          class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-3 text-sm font-semibold text-aura-glow transition-transform duration-200 hover:-translate-y-0.5"
        >
          Conseguir 10% off
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-ink/10 pt-8 text-xs text-ink/40 sm:flex-row">
      <p>© {new Date().getFullYear()} {site.name}. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href={site.legal.privacy} class="transition-colors hover:text-ink">Aviso de privacidad</a>
        <a href={site.legal.terms} class="transition-colors hover:text-ink">Términos</a>
      </div>
    </div>
  </div>
</footer>